{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hanok window request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "lattice_per_leaf"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1, "default": 1},
    "type": {"enum": ["single", "double"]},
    "hinge_side": {"enum": ["left", "right"]},
    "outer_mm": {"description": "외경: 완성 외곽 [가로, 세로] mm", "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 1, "maximum": 3000}},
    "inner_mm": {"description": "내경: 고정틀 안목 [가로, 세로] mm. 외곽 = 내경 + 2 × 고정틀 폭", "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 1, "maximum": 3000}},
    "lattice_per_leaf": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 32}},
    "preset": {"enum": ["standard_v1", "hanok_A3_portrait_R3"], "default": "standard_v1"},
    "picture": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["size_mm"], "properties": {
          "size_mm": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0.1, "maximum": 3000}},
          "margin_mm": {"type": "number", "minimum": 0, "maximum": 500, "default": 10}
        }}
      ]
    },
    "stock_mm": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [
      {"type": "number", "minimum": 1, "maximum": 3000},
      {"type": "number", "minimum": 1, "maximum": 3000},
      {"type": "number", "minimum": 5, "maximum": 60}
    ], "items": false, "default": [1220, 900, 20]}
  },
  "oneOf": [{"required": ["outer_mm"]}, {"required": ["inner_mm"]}],
  "allOf": [
    {"if": {"properties": {"type": {"const": "single"}}},
     "then": {"required": ["hinge_side"], "properties": {"preset": {"const": "standard_v1"}}},
     "else": {"not": {"required": ["hinge_side"]}}}
  ]
}
